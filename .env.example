# Copy to .env for local runs, or set these in Render's dashboard.

LOG_LEVEL=INFO

# Auth -- leave API_KEYS empty to run open (fine on a private network).
API_KEYS=
API_KEY_HEADER=X-API-Key

# Comma-separated; defaults to *
CORS_ORIGINS=

# Pipeline-matching defaults. Every one is overridable per request.
DEFAULT_CONFIDENCE_THRESHOLD=0.30
DEFAULT_IOU_THRESHOLD=0.70
DEFAULT_KEYPOINT_THRESHOLD=0.30
DEFAULT_OKS_THRESHOLD=0.70
DEFAULT_MAX_DETECTIONS=300

# Resource guards
MASK_MAX_SIDE=1024
MAX_INSTANCES_IN=2000
MAX_BATCH_ITEMS=64

# Used only when a payload omits the image size
DEFAULT_IMAGE_WIDTH=1920
DEFAULT_IMAGE_HEIGHT=1080
